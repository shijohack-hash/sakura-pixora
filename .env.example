# Cloudinary server credentials — NEVER expose CLOUDINARY_API_SECRET to the browser or GitHub.
# Get these from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public, non-secret value used by the client-side upload widget only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Supabase Auth — Project Settings -> API in your Supabase dashboard.
# The anon/publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
